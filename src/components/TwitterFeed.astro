---
import { TWITTER_HANDLE } from "@/consts";

const profileUrl = `https://x.com/${TWITTER_HANDLE}`;
const feedUrl = `https://api.fxtwitter.com/2/profile/${TWITTER_HANDLE}/statuses`;
---

<div
  id="twitter-feed-card"
  class="flex h-[70vh] flex-col overflow-hidden rounded-lg border-2 border-white bg-gradient-to-br from-white/[0.001] to-white/[0.01] lg:h-auto lg:min-h-0 lg:flex-1"
  data-feed-url={feedUrl}
  data-profile-url={profileUrl}
>
  <div class="flex items-center justify-start bg-white/95 px-4 py-2">
    <div class="flex space-x-2">
      <div class="h-3 w-3 rounded-full bg-black"></div>
      <div class="h-3 w-3 rounded-full bg-black"></div>
      <div class="h-3 w-3 rounded-full bg-black"></div>
    </div>
  </div>
  <div class="flex min-h-0 flex-1 flex-col p-6 tracking-wider">
    <a
      href={profileUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="mb-4 text-xl font-medium text-white"
    >
      <span class="ba mr-2 text-white/70">❯</span>@{TWITTER_HANDLE}
    </a>
    <div id="twitter-feed-posts" class="min-h-0 flex-1 overflow-y-auto">
      <a
        id="twitter-feed-fallback"
        href={profileUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm text-white/80 underline"
      >
        Tweets by @{TWITTER_HANDLE}
      </a>
    </div>
  </div>
</div>
<script is:inline>
  (function () {
    var card = document.getElementById("twitter-feed-card");
    var posts = document.getElementById("twitter-feed-posts");
    if (!card || !posts) return;
    var feedUrl = card.getAttribute("data-feed-url");
    var profileUrl = card.getAttribute("data-profile-url");
    if (!feedUrl) return;

    function formatDate(value) {
      var date = new Date(value);
      if (isNaN(date.getTime())) return "";
      return date.toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
        year: "numeric",
      });
    }

    function isStatusUrl(url) {
      return (
        typeof url === "string" &&
        (url.indexOf("https://x.com/") === 0 ||
          url.indexOf("https://twitter.com/") === 0)
      );
    }

    fetch(feedUrl)
      .then(function (response) {
        if (!response.ok) throw new Error("feed unavailable");
        return response.json();
      })
      .then(function (payload) {
        var results = payload && payload.results;
        if (!Array.isArray(results) || results.length === 0) return;
        posts.textContent = "";
        results.slice(0, 8).forEach(function (status) {
          if (!status || !status.text || !isStatusUrl(status.url)) return;
          var link = document.createElement("a");
          link.href = status.url;
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          link.className =
            "mb-3 block border border-white/30 p-3 text-sm text-white no-underline last:mb-0";
          var body = document.createElement("p");
          body.className = "mb-2 whitespace-pre-wrap text-white/90";
          body.textContent = status.text;
          link.appendChild(body);
          var when = formatDate(status.created_at);
          if (when) {
            var time = document.createElement("p");
            time.className = "text-xs text-white/60";
            time.textContent = when;
            link.appendChild(time);
          }
          posts.appendChild(link);
        });
        if (!posts.childElementCount && profileUrl) {
          posts.textContent = "";
          var fallback = document.createElement("a");
          fallback.href = profileUrl;
          fallback.target = "_blank";
          fallback.rel = "noopener noreferrer";
          fallback.className = "text-sm text-white/80 underline";
          fallback.textContent = "Tweets by @" + profileUrl.split("/").pop();
          posts.appendChild(fallback);
        }
      })
      .catch(function () {});
  })();
</script>
