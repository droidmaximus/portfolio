---
/** Put `hero.mp4` (and optionally `hero.webm`) in `/public`; ASCII is generated in the browser. */
---

<div
  class="hero-ascii-root absolute inset-0 h-full w-full select-none overflow-hidden text-white [clip-path:polygon(0_0,100%_0,100%_100%,4%_100%,0_97%)]"
  data-hero-ascii
>
  <video
    class="pointer-events-none absolute inset-0 h-full w-full object-cover opacity-0"
    muted
    autoplay
    loop
    playsinline
    webkit-playsinline
    preload="auto"
    disablepictureinpicture
    aria-hidden="true"
  >
    <source src="/hero.mp4" type="video/mp4" />
    <source src="/hero.webm" type="video/webm" />
  </video>
  <pre
    class="ascii-hero-pre absolute inset-0 m-0 block h-full max-h-full w-full max-w-none overflow-hidden whitespace-pre leading-none tracking-normal text-[clamp(7px,2.2vw,10px)] text-white opacity-100 contrast-150 md:text-[clamp(0.16rem,0.8vw,0.4rem)] [font-feature-settings:normal]"
    aria-label="ASCII art generated locally from video frames"></pre>
</div>

<script>
  const RAMP =
    " .'`^\",:;Il!i><~+_-?][}{1)(|\\/tfjrxnuvczXYUJCLQ0OZmwqpdbkhao*#MW&8%B@$";

  /** Stretch luminance around mid-gray before picking a glyph (higher = punchier). */
  function contrastLum(lum, amount = 2.05) {
    const v = (lum - 0.5) * amount + 0.5;
    return Math.max(0, Math.min(1, v));
  }

  function measureGlyph(pre) {
    const cs = getComputedStyle(pre);
    const fs = parseFloat(cs.fontSize) || 10;
    const probe = document.createElement("span");
    probe.setAttribute("aria-hidden", "true");
    probe.style.cssText =
      "position:absolute;left:0;top:0;visibility:hidden;pointer-events:none;white-space:pre;letter-spacing:0;";
    probe.textContent = "\u00A0".repeat(32);
    pre.appendChild(probe);
    const rect = probe.getBoundingClientRect();
    probe.remove();
    const charW = rect.width / 32 || fs * 0.6;
    const lineH = rect.height || fs;
    return { charW, lineH };
  }

  function drawVideoCover(ctx, video, cols, rows, charW, lineH) {
    const vw = video.videoWidth || cols;
    const vh = video.videoHeight || rows;
    const displayW = cols * charW;
    const displayH = rows * lineH;
    const scale = Math.max(displayW / vw, displayH / vh);
    const dw = (vw * scale) / charW;
    const dh = (vh * scale) / lineH;
    ctx.clearRect(0, 0, cols, rows);
    ctx.drawImage(video, (cols - dw) / 2, (rows - dh) / 2, dw, dh);
  }

  function initHeroAscii(root) {
    const video = root.querySelector("video");
    const pre = root.querySelector("pre");
    if (!video || !pre) return () => {};

    const canvas = document.createElement("canvas");
    const ctx = canvas.getContext("2d", { willReadFrequently: true });
    if (!ctx) return () => {};
    ctx.imageSmoothingEnabled = true;

    let cols = 72;
    let rows = 32;
    let charW = 6;
    let lineH = 10;
    let useVideo = false;
    let t0 = performance.now();
    let raf = 0;

    video.muted = true;
    video.defaultMuted = true;
    video.playsInline = true;
    video.setAttribute("muted", "");
    video.setAttribute("playsinline", "");
    video.setAttribute("webkit-playsinline", "");

    const resize = () => {
      const w = root.clientWidth;
      const h = root.clientHeight;
      if (w < 8 || h < 8) return;
      const glyph = measureGlyph(pre);
      charW = glyph.charW;
      lineH = glyph.lineH;
      const narrow = window.matchMedia("(max-width: 767px)").matches;
      const maxCols = narrow ? 96 : 360;
      const maxRows = narrow ? 72 : 180;
      cols = Math.max(32, Math.min(maxCols, Math.floor(w / charW)));
      rows = Math.max(16, Math.min(maxRows, Math.floor(h / lineH)));
      canvas.width = cols;
      canvas.height = rows;
    };

    const ro = new ResizeObserver(resize);
    ro.observe(root);
    resize();

    const drawFallback = (time) => {
      const id = ctx.createImageData(cols, rows);
      const elapsed = (time - t0) / 1000;
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const i = (y * cols + x) * 4;
          const n =
            Math.sin(x * 0.15 + elapsed * 1.2) *
              Math.cos(y * 0.12 - elapsed * 0.8) *
              0.5 +
            0.5;
          const v = Math.floor(n * 255);
          id.data[i] = v;
          id.data[i + 1] = v;
          id.data[i + 2] = v;
          id.data[i + 3] = 255;
        }
      }
      ctx.putImageData(id, 0, 0);
    };

    const renderAscii = () => {
      const now = performance.now();
      if (useVideo && video.readyState >= 2 && video.videoWidth > 0) {
        try {
          drawVideoCover(ctx, video, cols, rows, charW, lineH);
        } catch {
          useVideo = false;
          drawFallback(now);
        }
      } else {
        drawFallback(now);
      }

      const data = ctx.getImageData(0, 0, cols, rows).data;
      let out = "";
      for (let y = 0; y < rows; y++) {
        for (let x = 0; x < cols; x++) {
          const i = (y * cols + x) * 4;
          const raw =
            (data[i] * 0.299 + data[i + 1] * 0.587 + data[i + 2] * 0.114) /
            255;
          const lum = contrastLum(raw);
          const idx = Math.min(
            RAMP.length - 1,
            Math.floor(lum * RAMP.length),
          );
          const ch = RAMP[idx];
          /* NBSP keeps column width in monospace; U+0020 can collapse visually with some fonts */
          out += ch === " " ? "\u00A0" : ch;
        }
        out += "\n";
      }
      pre.textContent = out;
    };

    const tick = () => {
      if (!document.hidden) renderAscii();
      raf = requestAnimationFrame(tick);
    };

    const onReady = () => {
      video
        .play()
        .then(() => {
          useVideo = true;
        })
        .catch(() => {
          useVideo = false;
        });
    };

    const onError = () => {
      useVideo = false;
    };

    video.addEventListener("loadeddata", onReady);
    video.addEventListener("canplay", onReady);
    video.addEventListener("playing", () => {
      useVideo = true;
    });
    video.addEventListener("error", onError);

    if (video.readyState >= 2) onReady();

    const unlock = () => onReady();
    document.addEventListener("pointerdown", unlock, { passive: true });
    document.addEventListener("touchstart", unlock, { passive: true });

    const fontsReady =
      document.fonts && document.fonts.ready
        ? document.fonts.ready.then(resize)
        : Promise.resolve();

    raf = requestAnimationFrame(tick);

    return () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      video.removeEventListener("loadeddata", onReady);
      video.removeEventListener("canplay", onReady);
      video.removeEventListener("error", onError);
      document.removeEventListener("pointerdown", unlock);
      document.removeEventListener("touchstart", unlock);
      void fontsReady;
    };
  }

  let dispose = () => {};

  function boot() {
    dispose();
    const root = document.querySelector("[data-hero-ascii]");
    if (!root) {
      dispose = () => {};
      return;
    }
    const d = initHeroAscii(root);
    dispose = typeof d === "function" ? d : () => {};
  }

  boot();
  document.addEventListener("astro:page-load", boot);
</script>
